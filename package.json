{
  "name": "chaoxing-edge-toolbox",
  "version": "0.2.0",
  "private": true,
  "description": "按功能组织的学习通 Edge 工具箱：允许粘贴、题目提取、简答题 AI 作答与章节学习",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/codemirror": "^5.60.18",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "codemirror": "^5.65.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
